  "seed_areas": [
    {
      "id": "A01",
      "title": "Pool oracle adapter and price loading",
      "files": [
        "pool-oracle-adapter/src/lib.rs",
        "pool-oracle-adapter/src/parent.rs",
        "pool/src/pool/pool.rs"
      ],
      "focus": "SEP-40 adapter bucketing, freshness and decimals; how load_price consumes it. Adverse-but-valid prices are in scope; wrong data is not. L-05 is known."
    },
    {
      "id": "A02",
      "title": "Bad debt recognition and defaults",
      "files": [
        "pool/src/pool/bad_debt.rs",
        "pool/src/auctions/bad_debt_auction.rs",
        "backstop/src/dependencies/pool.rs",
        "shared/backstop_threshold.rs",
        "pool/src/pool/reserve.rs"
      ],
      "focus": "When debt becomes bad debt, how defaults lower b_rate, who absorbs the loss, and whether anyone can trigger or dodge it to shift losses or extract value."
    },
    {
      "id": "A03",
      "title": "User liquidation auctions",
      "files": [
        "pool/src/auctions/auction.rs",
        "pool/src/auctions/user_liquidation_auction.rs",
        "pool/src/pool/health_factor.rs",
        "pool/src/pool/user.rs"
      ],
      "focus": "Auction creation, scaling over time, partial and full fills, deletion; can a liquidator take more collateral than allowed, or a borrower escape or grief to leave losses on lenders?"
    },
    {
      "id": "A04",
      "title": "Backstop interest auctions and backstop credit",
      "files": [
        "pool/src/auctions/backstop_interest_auction.rs",
        "pool/src/pool/interest.rs",
        "pool/src/pool/reserve.rs",
        "backstop/src/contract.rs"
      ],
      "focus": "Accrual of backstop credit, interest auction lots and bids, and transfers between pool and backstop."
    },
    {
      "id": "A05",
      "title": "Reserve accounting and rates",
      "files": [
        "pool/src/pool/reserve.rs",
        "pool/src/math.rs",
        "pool/src/pool/interest.rs",
        "pool/src/constants.rs"
      ],
      "focus": "b_rate / d_rate, supply and liability totals, utilization, rounding direction on every conversion, behaviour after defaults."
    },
    {
      "id": "A06",
      "title": "User actions, submit and flash loans",
      "files": [
        "pool/src/pool/actions.rs",
        "pool/src/pool/submit.rs",
        "pool/src/pool/user.rs",
        "pool/src/contract.rs"
      ],
      "focus": "Supply, withdraw, borrow, repay, collateral moves and flash loans: health checks, ordering of state updates and transfers, authorization, request batching."
    },
    {
      "id": "A07",
      "title": "Pool configuration, status, freezes and factory",
      "files": [
        "pool/src/pool/config.rs",
        "pool/src/pool/status.rs",
        "pool/src/storage.rs",
        "pool/src/contract.rs",
        "pool-factory/src/pool_factory.rs"
      ],
      "focus": "Status transitions and what each status allows, sealed reserve configuration, factory deployment parameters. Intended ADR-0008/0011 restrictions are out of scope; defects in enforcing them are in."
    },
    {
      "id": "A08",
      "title": "Backstop deposits, withdrawals and queue",
      "files": [
        "backstop/src/backstop/deposit.rs",
        "backstop/src/backstop/withdrawal.rs",
        "backstop/src/backstop/user.rs",
        "backstop/src/storage.rs",
        "backstop/src/contract.rs"
      ],
      "focus": "Share accounting, queued withdrawals, dequeue and withdraw timing, interaction with bad debt draws on the backstop."
    },
    {
      "id": "A09",
